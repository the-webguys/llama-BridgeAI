{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "permission": {
    "edit": "ask",
    "bash": "deny",
    "write": "ask"
  },
  "agent": {
    "Gemma4": {
      "model": "llama/gemma-4-E4B-it-Q4_K_M",
      "permission": {
        "*": "ask",
        "edit": "ask",
        "bash": "deny",
        "write": "ask"
      }
    },
    "chat": {
      "model": "llama/gemma-2-9b-instruct-Q6_K",
      "permission": {
        "*": "ask",
        "edit": "ask",
        "bash": "deny",
        "write": "ask"
      }
    },
    "plan": {
      "model": "llama/qwen2.5-coder-14b-instruct-q4_K_M",
      "permission": {
        "*": "ask",
        "edit": "ask",
        "bash": "deny",
        "write": "ask"
      }
    },
    "build": {
      "model": "llama/qwen2.5-coder-14b-instruct-q4_K_M",
      "permission": {
        "*": "ask",
        "edit": "ask", // CRITICAL: OpenCode uses 'edit' to control 'write'
        "write": "ask",
        "bash": "deny"
      }
    },
    "code": {
      "model": "llama/qwen2.5-coder-32b-instruct-q4_K_M",
      "permission": {
        "*": "ask",
        "edit": "ask", // CRITICAL: OpenCode uses 'edit' to control 'write'
        "write": "ask",
        "bash": "deny"
      }
    }
  },
  "provider": {
    "llama": {
      "name": "llama-server",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:3000/v1", //"http://127.0.0.1:8080/v1/",
        "apiKey": "sk-no-key-required",
        "toolParser": [
          {
            "type": "xml"
          },
          {
            "type": "markdown-json"
          },
          {
            "type": "json"
          }
        ],
        "tools": true,
        "reasoning": true
      },
      "models": {
        "qwen2.5-coder-14b-instruct-q4_K_M": {
          "name": "qwen2.5-coder-14b",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "qwen2.5-coder-32b-instruct-q4_K_M": {
          "name": "qwen2.5-coder-32b",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 2048
          }
        },
        "qwen3-14b-q4_k_s": {
          "name": "qwen3-14b-q4_k_s",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "granite-4.0-h-small-Q4_K_M": {
          "name": "granite-4-small",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 4096
          }
        },
        "granite-4.0-h-tiny-Q4_K_M": {
          "name": "granite-4-tiny",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "gemma-2-9b-instruct-Q6_K": {
          "name": "gemma-2-9b",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "gemma-4-E4B-it-Q4_K_M": {
          "name": "gemma-4-E4B",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  }
}
